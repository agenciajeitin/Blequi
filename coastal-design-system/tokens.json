{
  "$schema": "https://tr.designtokens.org/format/",
  "name": "Coastal World 1:1 Design System",
  "version": "1.0.0",
  "colors": {
    "brand": {
      "navy": { "$value": "#3b3777", "$type": "color", "description": "Primary ink, icons, headings, cursor outline, map pins" },
      "navyDeep": { "$value": "#2c285e", "$type": "color" },
      "mint": { "$value": "#02c6a7", "$type": "color", "description": "Primary positive CTA, close orb, active status" },
      "mintLight": { "$value": "#1de2c2", "$type": "color" },
      "mintSoft": { "$value": "#86e0cf", "$type": "color" },
      "mintShadow": { "$value": "#019f86", "$type": "color" },
      "coral": { "$value": "#f2676f", "$type": "color", "description": "Highlight text, dialog corner badge, discard orb, alerts" },
      "coralSoft": { "$value": "#f8b3b7", "$type": "color" },
      "peach": { "$value": "#ffdbc9", "$type": "color" },
      "yellow": { "$value": "#f6d35f", "$type": "color", "description": "Coins, sun lanterns, rewards, clock face" },
      "yellowSoft": { "$value": "#fae9af", "$type": "color" },
      "lavender": { "$value": "#9e9bbe", "$type": "color" },
      "surfaceWhite": { "$value": "#ffffff", "$type": "color" },
      "surfaceTint": { "$value": "#f4f8ff", "$type": "color" },
      "surfaceMuted": { "$value": "#eef3fa", "$type": "color" }
    },
    "environment": {
      "daylight": {
        "skyZenith": "#00b4ff",
        "skyMid": "#42d2fb",
        "skyHorizon": "#c2f5f8",
        "fog": "#bceef5",
        "waterDeep": "#65b2e6",
        "waterShallow": "#7ed9f2",
        "foam": "#ffffff"
      },
      "golden": {
        "skyZenith": "#0ea5e9",
        "skyMid": "#5cd3f6",
        "skyHorizon": "#ffe8c4",
        "fog": "#bfeff4",
        "waterDeep": "#48b2df",
        "waterShallow": "#6fe0e8",
        "foam": "#ffffff"
      },
      "dusk": {
        "skyZenith": "#273573",
        "skyMid": "#5a67b8",
        "skyHorizon": "#f2a5b6",
        "fog": "#8d88c4",
        "waterDeep": "#30669e",
        "waterShallow": "#4795c4",
        "foam": "#e2f3ff"
      }
    },
    "avatarPalettes": [
      { "id": "peach", "swatch": "#f2b99b", "body": "#e9ae8c", "limbs": "#d98f70", "face": "#fff3d6", "accent": "#49c6e5", "phoneCase": "#f4c8b0", "hand": "#e2a382" },
      { "id": "lavender", "swatch": "#bfb6de", "body": "#9b8ec9", "limbs": "#7a6cb0", "face": "#fff1d9", "accent": "#02c6a7", "phoneCase": "#cbc3e6", "hand": "#a699d2" },
      { "id": "cobalt", "swatch": "#89a2c9", "body": "#3e84d6", "limbs": "#2f65b5", "face": "#fff1d9", "accent": "#f6d35f", "phoneCase": "#a6bee0", "hand": "#5c96db" },
      { "id": "aqua", "swatch": "#8bcbb8", "body": "#00bcc7", "limbs": "#3f5ea8", "face": "#d7b4e4", "accent": "#9f82df", "phoneCase": "#9ed7c7", "hand": "#2ec8cf" },
      { "id": "berry", "swatch": "#a14e61", "body": "#7b3556", "limbs": "#6c4972", "face": "#fff0c4", "accent": "#30c5f0", "phoneCase": "#d8aeb2", "hand": "#b76c79" }
    ]
  },
  "typography": {
    "fontDisplay": "\"Fredoka\", \"Nunito\", system-ui, sans-serif",
    "fontSans": "\"Nunito\", \"Comfortaa\", system-ui, -apple-system, sans-serif",
    "fontMono": "\"JetBrains Mono\", ui-monospace, monospace"
  },
  "radii": {
    "keycap": "10px",
    "card": "22px",
    "modal": "30px",
    "phoneFrame": "40px",
    "phoneScreen": "30px",
    "cornerWave": "56px",
    "pill": "9999px"
  },
  "motion": {
    "easeSmooth": "cubic-bezier(0.23, 1, 0.32, 1)",
    "easeBounce": "cubic-bezier(0.19, 1.4, 0.3, 1)",
    "easePress": "cubic-bezier(0, 0.96, 0.22, 1)"
  }
}
